# Local LLM API (wraps the Claude Code CLI)
LLM_API_URL=http://localhost:5052/api/prompts

# Work tracker used when --tracker is not given: ado or github
DEFAULT_TRACKER=ado

# Azure DevOps (required when the tracker is ado)
ADO_ORGANIZATION=your-organization
ADO_PROJECT=your-project
ADO_PAT=your-personal-access-token

# GitHub (required when the tracker is github)
# Fine-grained token with read access to the issues of the repository
GITHUB_TOKEN=your-github-token

# Base branch that new branches are created from
BASE_BRANCH=develop
